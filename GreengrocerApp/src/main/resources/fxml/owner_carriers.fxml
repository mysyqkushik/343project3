<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.groupxx.greengrocer.controller.OwnerCarriersController"
      stylesheets="@../css/app.css"
      spacing="16">

    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <!-- Toolbar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
         <Button text="Add Carrier" onAction="#onAddCarrier" styleClass="button-primary"/>
         <Button text="Delete Selected" onAction="#onDeleteCarrier" styleClass="button-danger"/>
         <Button text="Toggle Active" onAction="#onToggleActive" styleClass="button"/>
         <Region HBox.hgrow="ALWAYS"/>
         <Button text="Refresh" onAction="#onRefresh" styleClass="button"/>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" orientation="VERTICAL" dividerPositions="0.6">
        <items>
            <VBox spacing="8">
                 <Label text="Active Carriers" styleClass="title-medium"/>
                 <TableView fx:id="carriersTable" VBox.vgrow="ALWAYS">
                     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                     <columns>
                         <TableColumn fx:id="usernameCol" text="Username"/>
                         <TableColumn fx:id="activeCol" text="Active"/>
                         <TableColumn fx:id="avgRatingCol" text="Rating"/>
                     </columns>
                 </TableView>
            </VBox>
            
            <VBox spacing="8">
                 <HBox spacing="16" alignment="CENTER_LEFT">
                     <Label text="Deleted History" styleClass="title-medium"/>
                     <Button text="Undo Delete" onAction="#onUndoDeletion" styleClass="button"/>
                 </HBox>
                 <TableView fx:id="deletedTable" VBox.vgrow="ALWAYS">
                     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                     <columns>
                         <TableColumn fx:id="deletedUsernameCol" text="Username"/>
                         <TableColumn fx:id="deletedAvgRatingCol" text="Rating"/>
                     </columns>
                 </TableView>
            </VBox>
        </items>
    </SplitPane>
    <Label fx:id="statusLabel" styleClass="status"/>
</VBox>
