<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.groupxx.greengrocer.controller.OwnerReportsController">

    <top>
        <VBox spacing="8">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Reports" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Region minWidth="20"/>
                        <Label text="Days:"/>
                        <ComboBox fx:id="daysCombo" prefWidth="80"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="Reload" onAction="#onReload"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="12">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <children>
                        <TitledPane text="Customer Growth &amp; Activity" collapsible="false">
                            <content>
                                <LineChart fx:id="customersChart" prefHeight="250" prefWidth="700" animated="false">
                                    <xAxis>
                                        <CategoryAxis label="Day"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Count" autoRanging="true"/>
                                    </yAxis>
                                </LineChart>
                            </content>
                        </TitledPane>

                        <TitledPane text="Daily sales (orders + revenue)" collapsible="false">
                            <content>
                                <LineChart fx:id="salesChart" prefHeight="250" prefWidth="700">
                                    <xAxis>
                                        <CategoryAxis label="Day"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Value"/>
                                    </yAxis>
                                </LineChart>
                            </content>
                        </TitledPane>

                        <TitledPane text="Carrier ratings" collapsible="false">
                            <content>
                                <VBox spacing="8">
                                    <children>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Filter:"/>
                                                <TextField fx:id="carrierSearchField" promptText="Search carrier..." prefWidth="150"/>
                                            </children>
                                        </HBox>
                                        <BarChart fx:id="ratingsChart" prefHeight="250" prefWidth="700" categoryGap="20" barGap="5">
                                            <xAxis>
                                                <CategoryAxis label="Carrier"/>
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis label="Average rating" autoRanging="true"/>
                                            </yAxis>
                                        </BarChart>
                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
