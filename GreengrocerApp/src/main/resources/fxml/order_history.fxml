<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.groupxx.greengrocer.controller.OrderHistoryController"
      stylesheets="@../css/app.css"
      style="-fx-background-color: -fx-background;">

    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="top-bar">
        <Label text="My Orders" styleClass="headline-medium"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="button"/>
        <Button text="Close" onAction="#onClose" styleClass="button"/>
    </HBox>
    
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <padding>
             <Insets top="16" right="24" bottom="16" left="24"/>
        </padding>
        
        <Label fx:id="ruleLabel" styleClass="caption" wrapText="true"/>
        
        <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colOrderTime" text="Date Placed"/>
                <TableColumn fx:id="colReqDelivery" text="Requested Delivery"/>
                <TableColumn fx:id="colStatus" text="Status"/>
                <TableColumn fx:id="colTotal" text="Total"/>
                <TableColumn fx:id="colCarrier" text="Carrier"/>
                <TableColumn fx:id="colAction" text="Actions" prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
