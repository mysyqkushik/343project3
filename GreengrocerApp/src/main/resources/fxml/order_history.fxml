<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.groupxx.greengrocer.controller.OrderHistoryController">

    <top>
        <VBox spacing="6">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Label text="Order History" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="ruleLabel"/>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="ordersTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="Order ID" prefWidth="90"/>
                <TableColumn fx:id="colOrderTime" text="Order Time" prefWidth="160"/>
                <TableColumn fx:id="colReqDelivery" text="Requested Delivery" prefWidth="170"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                <TableColumn fx:id="colTotal" text="Total (incl. VAT)" prefWidth="140"/>
                <TableColumn fx:id="colCarrier" text="Carrier" prefWidth="120"/>
                <TableColumn fx:id="colAction" text="Actions" prefWidth="240"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Button text="Refresh" onAction="#onRefresh"/>
                <Button text="Close" onAction="#onClose"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
