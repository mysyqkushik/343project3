<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.groupxx.greengrocer.controller.OwnerProductsController"
           stylesheets="@../css/app.css"
           dividerPositions="0.6">
    <items>
        <!-- Product List -->
        <VBox spacing="12">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" minWidth="40"/>
                    <TableColumn fx:id="colName" text="Name"/>
                    <TableColumn fx:id="colCategory" text="Category"/>
                    <TableColumn fx:id="colPrice" text="Price/kg"/>
                    <TableColumn fx:id="colStock" text="Stock (kg)"/>
                    <TableColumn fx:id="colThreshold" text="Threshold"/>
                    <TableColumn fx:id="colActive" text="Active"/>
                </columns>
            </TableView>
            <FlowPane hgap="8" vgap="8">
                 <Button text="Reload List" onAction="#onReload" styleClass="button"/>
                 <Button text="Create New" onAction="#onNew" styleClass="button"/>
                 <Button text="Toggle Active" onAction="#onToggleActive" styleClass="button"/>
             </FlowPane>
        </VBox>

        <!-- Editor Form -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="16" styleClass="card" style="-fx-border-color: transparent;">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                
                <Label text="Product Details" styleClass="headline-medium"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="ID:" styleClass="label-large"/>
                    <Label fx:id="selectedIdLabel" text="-" styleClass="body-large"/>
                </HBox>
                <Separator/>
                
                <GridPane hgap="12" vgap="16" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-large"/>
                    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    
                    <Label text="Category" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-large"/>
                    <ComboBox fx:id="categoryBox" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>
                    
                    <Label text="Price/kg" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-large"/>
                    <TextField fx:id="priceField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    
                    <Label text="Stock (kg)" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label-large"/>
                    <TextField fx:id="stockField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    
                    <Label text="Threshold" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="label-large"/>
                    <TextField fx:id="thresholdField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    
                    <Label text="Status" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="label-large"/>
                    <CheckBox fx:id="activeCheck" text="Active" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
                
                <Label text="Pricing Rule: Customer price doubles if stock ≤ threshold." 
                       wrapText="true" styleClass="caption"/>
                
                <Separator/>
                
                <VBox spacing="12">
                     <Button text="Upload New Image..." onAction="#onUploadImage" styleClass="button" maxWidth="Infinity"/>
                     <Button text="Save Changes" onAction="#onSave" styleClass="button-primary" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </items>
</SplitPane>
