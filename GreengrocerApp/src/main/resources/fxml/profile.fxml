<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.groupxx.greengrocer.controller.ProfileController">

    <top>
        <VBox spacing="6" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Profile" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="userLabel" text=""/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70"/>
                </columnConstraints>

                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Address:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="addressArea" prefRowCount="3" wrapText="true"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Button text="Change Password..." onAction="#onChangePassword" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="statusLabel" text="" style="-fx-text-fill: rgba(0,0,0,0.65);"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Button text="Cancel" onAction="#onCancel"/>
            <Button fx:id="saveBtn" text="Save" onAction="#onSave"/>
        </HBox>
    </bottom>

</BorderPane>
