<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.groupxx.greengrocer.controller.CarrierHomeController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <children>
                <Label text="Carrier Panel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Profile" onAction="#onOpenProfile"/>
                <Button text="Logout" onAction="#onLogout"/>
            </children>
        </HBox>
    </top>

    <center>
        <TabPane>
            <tabs>
                <Tab text="Available" closable="false">
                    <BorderPane>
                        <center>
                            <TableView fx:id="availableTable">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="aId" text="ID"/>
                                    <TableColumn fx:id="aCustomer" text="Customer"/>
                                    <TableColumn fx:id="aAddress" text="Address"/>
                                    <TableColumn fx:id="aReq" text="Requested Delivery"/>
                                    <TableColumn fx:id="aTotal" text="Total (incl. VAT)"/>
                                </columns>
                            </TableView>
                        </center>
                        <bottom>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <children>
                                    <Button text="Claim Selected" onAction="#onClaimSelected"/>
                                </children>
                            </HBox>
                        </bottom>
                    </BorderPane>
                </Tab>

                <Tab text="Current/Selected" closable="false">
                    <BorderPane>
                        <center>
                            <TableView fx:id="currentTable">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="cId" text="ID"/>
                                    <TableColumn fx:id="cCustomer" text="Customer"/>
                                    <TableColumn fx:id="cAddress" text="Address"/>
                                    <TableColumn fx:id="cReq" text="Requested Delivery"/>
                                    <TableColumn fx:id="cTotal" text="Total (incl. VAT)"/>
                                </columns>
                            </TableView>
                        </center>
                        <bottom>
                            <HBox spacing="10" alignment="CENTER_RIGHT">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <children>
                                    <Button text="Mark Delivered" onAction="#onMarkDelivered"/>
                                </children>
                            </HBox>
                        </bottom>
                    </BorderPane>
                </Tab>

                <Tab text="Completed" closable="false">
                    <TableView fx:id="completedTable">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="dId" text="ID"/>
                            <TableColumn fx:id="dCustomer" text="Customer"/>
                            <TableColumn fx:id="dDelivered" text="Delivered At"/>
                            <TableColumn fx:id="dTotal" text="Total (incl. VAT)"/>
                        </columns>
                    </TableView>
                </Tab>

                <Tab text="My Reviews" closable="false">
                    <TableView fx:id="reviewsTable">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="rDate" text="Date"/>
                            <TableColumn fx:id="rCustomer" text="Customer"/>
                            <TableColumn fx:id="rRating" text="Rating"/>
                            <TableColumn fx:id="rComment" text="Comment"/>
                        </columns>
                    </TableView>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>
