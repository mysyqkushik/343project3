<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.groupxx.greengrocer.controller.CarrierHomeController"
      stylesheets="@../css/app.css"
      style="-fx-background-color: -fx-background;">

    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="top-bar">
        <Label text="Carrier Panel" styleClass="headline-medium"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="My Profile" onAction="#onOpenProfile" styleClass="button"/>
        <Button text="Sign Out" onAction="#onLogout" styleClass="button"/>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Available Orders">
                <VBox spacing="16">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Open Orders for Delivery" styleClass="title-medium"/>
                    <TableView fx:id="availableTable" VBox.vgrow="ALWAYS">
                         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                         <columns>
                             <TableColumn fx:id="aId" text="ID" prefWidth="60"/>
                             <TableColumn fx:id="aCustomer" text="Customer"/>
                             <TableColumn fx:id="aAddress" text="Address"/>
                             <TableColumn fx:id="aReq" text="Requested Time"/>
                             <TableColumn fx:id="aTotal" text="Total"/>
                         </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Claim Selected Order" onAction="#onClaimSelected" styleClass="button-primary"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="My Current Delivery">
                <VBox spacing="16">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="In Progress" styleClass="title-medium"/>
                    <TableView fx:id="currentTable" VBox.vgrow="ALWAYS">
                         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                         <columns>
                             <TableColumn fx:id="cId" text="ID" prefWidth="60"/>
                             <TableColumn fx:id="cCustomer" text="Customer"/>
                             <TableColumn fx:id="cAddress" text="Address"/>
                             <TableColumn fx:id="cReq" text="Requested Time"/>
                             <TableColumn fx:id="cTotal" text="Total"/>
                         </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Mark as Delivered" onAction="#onMarkDelivered" styleClass="button-primary"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Completed">
                <VBox spacing="16">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <TableView fx:id="completedTable" VBox.vgrow="ALWAYS">
                         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                         <columns>
                             <TableColumn fx:id="dId" text="ID" prefWidth="60"/>
                             <TableColumn fx:id="dCustomer" text="Customer"/>
                             <TableColumn fx:id="dDelivered" text="Delivered At"/>
                             <TableColumn fx:id="dTotal" text="Total"/>
                         </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <Tab text="My Reviews">
                <VBox spacing="16">
                     <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                     <TableView fx:id="reviewsTable" VBox.vgrow="ALWAYS">
                         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                         <columns>
                             <TableColumn fx:id="rDate" text="Date"/>
                             <TableColumn fx:id="rCustomer" text="Customer"/>
                             <TableColumn fx:id="rRating" text="Rating"/>
                             <TableColumn fx:id="rComment" text="Comment"/>
                         </columns>
                     </TableView>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
