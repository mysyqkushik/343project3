<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.groupxx.greengrocer.controller.OwnerDiscountsController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <children>
                <Label text="Discounts &amp; Loyalty" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Refresh All" onAction="#onReload"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <!-- Coupons Section -->
            <VBox spacing="10">
                <Label text="Coupons" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                <TableView fx:id="couponTable" prefHeight="150">
                    <columns>
                        <TableColumn fx:id="colCode" text="Code" prefWidth="120"/>
                        <TableColumn fx:id="colRate" text="Rate" prefWidth="80"/>
                        <TableColumn fx:id="colMinSubtotal" text="Min Subtotal" prefWidth="100"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="newCouponCodeField" promptText="Code (e.g., SAVE10)" prefWidth="120"/>
                    <TextField fx:id="newCouponRateField" promptText="Rate (e.g., 10 or 0.10)" prefWidth="120"/>
                    <TextField fx:id="newCouponMinSubtotalField" promptText="Min Subtotal (e.g., 200)" prefWidth="120"/>
                    <Button text="Add/Update" onAction="#onAddCoupon"/>
                    <Button text="Delete Selected" onAction="#onDeleteCoupon"/>
                </HBox>

                <Label wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: gray;"
                       text="Rate can be decimal (0.10) or percentage (10). Coupon applies if code matches and subtotal >= min."/>
            </VBox>

            <Separator/>

            <!-- Loyalty Section -->
            <VBox spacing="10">
                <Label text="Loyalty Discount" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180" halignment="RIGHT"/>
                        <ColumnConstraints hgrow="ALWAYS" prefWidth="200"/>
                    </columnConstraints>

                    <Label text="Loyalty discount rate" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="loyaltyRateField" promptText="e.g., 0.05 or 5" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Min delivered orders" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="loyaltyMinDeliveredField" promptText="e.g., 5" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="10">
                    <Button text="Save Loyalty Settings" onAction="#onSaveLoyalty"/>
                </HBox>

                <Label wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: gray;"
                       text="Loyalty discount applies if customer has delivered orders >= min."/>
            </VBox>

        </VBox>
    </center>

</BorderPane>
