<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.groupxx.greengrocer.controller.OwnerDiscountsController"
      stylesheets="@../css/app.css"
      style="-fx-background-color: -fx-background;"
      spacing="16">

    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    
    <HBox spacing="16" alignment="CENTER_LEFT">
        <Label text="Discounts &amp; Loyalty" styleClass="headline-medium"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Reload All" onAction="#onReload" styleClass="button"/>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.6" orientation="VERTICAL">
        <items>
            <!-- Coupons Section -->
            <VBox spacing="12">
                <Label text="Active Coupons" styleClass="title-medium"/>
                
                <TableView fx:id="couponTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colCode" text="Code"/>
                        <TableColumn fx:id="colRate" text="Rate"/>
                        <TableColumn fx:id="colMinSubtotal" text="Min Subtotal"/>
                    </columns>
                </TableView>

                <FlowPane hgap="12" vgap="12" alignment="CENTER_LEFT">
                     <TextField fx:id="newCouponCodeField" promptText="CODE"/>
                     <TextField fx:id="newCouponRateField" promptText="Rate (0.10 or 10)"/>
                     <TextField fx:id="newCouponMinSubtotalField" promptText="Min Subtotal"/>
                     <Button text="Create/Update" onAction="#onAddCoupon" styleClass="button-primary"/>
                     <Button text="Delete Selected" onAction="#onDeleteCoupon" styleClass="button-danger"/>
                </FlowPane>
                <Label text="Info: Rate &lt; 1 is decimal (0.1 = 10%), &gt; 1 is percentage (10 = 10%)." styleClass="caption"/>
            </VBox>

            <!-- Loyalty Section -->
            <VBox spacing="16" styleClass="card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                
                <Label text="Loyalty Program Settings" styleClass="title-large"/>
                <Separator/>
                
                <GridPane hgap="16" vgap="16">
                     <columnConstraints>
                         <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                         <ColumnConstraints hgrow="ALWAYS" maxWidth="300"/>
                     </columnConstraints>
                     
                     <Label text="Discount Rate" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-large"/>
                     <TextField fx:id="loyaltyRateField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                     
                     <Label text="Min Orders" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-large"/>
                     <TextField fx:id="loyaltyMinDeliveredField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>
                
                <HBox spacing="16">
                    <Button text="Save Settings" onAction="#onSaveLoyalty" styleClass="button-primary"/>
                </HBox>
                
                <Label text="Applies automatically when a customer has enough delivered orders." styleClass="caption"/>
            </VBox>
        </items>
    </SplitPane>
</VBox>
