<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.groupxx.greengrocer.controller.CustomerHomeController"
      stylesheets="@../css/app.css"
      style="-fx-background-color: -fx-background;">

    <!-- Top Bar -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="top-bar">
        <Label text="Greengrocer" styleClass="headline-medium"/>
        <HBox spacing="16" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <VBox alignment="CENTER_RIGHT" spacing="2">
                 <Label text="Welcome," styleClass="label-medium" style="-fx-text-fill: -fx-text-secondary;"/>
                 <Label fx:id="usernameLabel" styleClass="display-small"/>
            </VBox>
            <StackPane styleClass="avatar-container" prefWidth="56" prefHeight="56" minWidth="56" minHeight="56" maxWidth="56" maxHeight="56">
                <!-- Strict Circular Clip -->
                <clip>
                    <javafx.scene.shape.Circle radius="28" centerX="28" centerY="28"/>
                </clip>
                <Region styleClass="avatar-bg"/> <!-- Background placeholder -->
                <Region styleClass="avatar-icon"/> 
            </StackPane>
        </HBox>
        
        <Button text="Sign Out" onAction="#onLogout" styleClass="button"/>
    </HBox>

    <!-- Navigation Bar -->
    <ScrollPane fitToHeight="true" vbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-padding: 0;">
        <content>
            <HBox spacing="8" style="-fx-padding: 8px 16px;">
                <Button text="All Products" styleClass="button-primary"/> <!-- Visual marker only -->
                <Button text="My Orders" onAction="#onOpenOrders" styleClass="button"/>
                <Button text="Messages" onAction="#onOpenMessages" styleClass="button"/>
                <Button text="Profile" onAction="#onOpenProfile" styleClass="button"/>
                <Region prefWidth="16"/>
                <Button fx:id="cartButton" text="Shopping Cart" onAction="#onOpenCart" styleClass="button-primary"/>
            </HBox>
        </content>
    </ScrollPane>

    <!-- Main Content -->
    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="16" right="24" bottom="16" left="24"/>
        </padding>

        <!-- Search & Filter -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search products..." HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="sortCombo" promptText="Sort By" prefWidth="300"/>
            <Button text="Clear" onAction="#onClearSearch" styleClass="button"/>
        </HBox>

        <!-- Products Tabs -->
        <TabPane fx:id="productsTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Vegetables">
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                        <content>
                            <FlowPane fx:id="vegetablesFlow" hgap="16" vgap="16" alignment="TOP_LEFT">
                                <padding><Insets top="16" bottom="16" left="4" right="4"/></padding>
                            </FlowPane>
                        </content>
                    </ScrollPane>
                </Tab>
                <Tab text="Fruits">
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                        <content>
                            <FlowPane fx:id="fruitsFlow" hgap="16" vgap="16" alignment="TOP_LEFT">
                                <padding><Insets top="16" bottom="16" left="4" right="4"/></padding>
                            </FlowPane>
                        </content>
                    </ScrollPane>
                </Tab>
            </tabs>
        </TabPane>

        <Label fx:id="statusLabel" styleClass="status" wrapText="true"/>
    </VBox>
</VBox>
