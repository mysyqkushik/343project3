<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.groupxx.greengrocer.controller.CustomerHomeController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="User:"/>
                <Label fx:id="usernameLabel"/>
                <Button text="Orders" onAction="#onOpenOrders"/>
                <Button text="Messages" onAction="#onOpenMessages"/>
                <Button text="Profile" onAction="#onOpenProfile"/>
                <Button fx:id="cartButton" text="Cart" onAction="#onOpenCart"/>
                <Button text="Logout" onAction="#onLogout"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Search:"/>
                        <TextField fx:id="searchField" promptText="Name..." prefWidth="150"/>
                        <Label text="Sort By:"/>
                        <ComboBox fx:id="sortCombo" prefWidth="160"/>
                        <Button text="Clear" onAction="#onClearSearch"/>
                    </children>
                </HBox>

                <TabPane fx:id="productsTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Vegetables">
                            <content>
                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                                    <content>
                                        <FlowPane fx:id="vegetablesFlow" hgap="15" vgap="15">
                                            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                                        </FlowPane>
                                    </content>
                                </ScrollPane>
                            </content>
                        </Tab>
                        <Tab text="Fruits">
                            <content>
                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                                    <content>
                                        <FlowPane fx:id="fruitsFlow" hgap="15" vgap="15">
                                            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                                        </FlowPane>
                                    </content>
                                </ScrollPane>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>

                <Label fx:id="statusLabel"/>
            </children>
        </VBox>
    </center>

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

</BorderPane>
