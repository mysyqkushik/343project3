<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.groupxx.greengrocer.controller.OwnerCarrierReviewsController"
      stylesheets="@../css/app.css"
      spacing="16">

    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <Label text="Carrier Reviews" styleClass="headline-medium"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="button"/>
    </HBox>

    <TableView fx:id="reviewsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="70"/>
            <TableColumn fx:id="colCarrier" text="Carrier"/>
            <TableColumn fx:id="colCustomer" text="Customer"/>
            <TableColumn fx:id="colRating" text="Rating"/>
            <TableColumn fx:id="colComment" text="Comment" prefWidth="300"/>
            <TableColumn fx:id="colDate" text="Date"/>
        </columns>
    </TableView>
</VBox>
