<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" 
            xmlns="http://javafx.com/javafx" 
            xmlns:fx="http://javafx.com/fxml" 
            fx:controller="com.groupxx.greengrocer.controller.LoginController"
            stylesheets="@../css/app.css">
    
    <content>
        <StackPane style="-fx-background-color: -fx-primary;">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <VBox spacing="32" alignment="CENTER" styleClass="card" maxWidth="440" style="-fx-background-color: white;">
                <padding>
                    <Insets top="48" right="40" bottom="48" left="40"/>
                </padding>
                
                <!-- Header -->
                <VBox spacing="8" alignment="CENTER">
                    <Label text="Greengrocer" styleClass="display-medium" style="-fx-text-fill: -fx-primary; -fx-font-size: 45px;"/>
                    <Label text="Fresh produce delivered daily" styleClass="title-medium" style="-fx-text-fill: -fx-text-secondary;"/>
                </VBox>

                <!-- Input Fields -->
                <VBox spacing="24" maxWidth="Infinity">
                    <TextField fx:id="usernameField" promptText="Username" styleClass="text-field" prefHeight="56"/>
                    <PasswordField fx:id="passwordField" promptText="Password" onAction="#onLogin" styleClass="password-field" prefHeight="56"/>
                </VBox>

                <!-- Actions -->
                <VBox spacing="16" maxWidth="Infinity">
                    <Button fx:id="loginButton" text="Sign In" onAction="#onLogin" 
                            styleClass="button-primary" maxWidth="Infinity" prefHeight="48"/>
                    
                    <HBox alignment="CENTER" spacing="8">
                        <Label text="Don't have an account?" styleClass="body-medium"/>
                        <Button fx:id="registerButton" text="Create Account" onAction="#onOpenRegister" 
                                styleClass="button" style="-fx-padding: 8 16; -fx-border-color: transparent;"/>
                    </HBox>
                </VBox>

                <Label fx:id="statusLabel" styleClass="status" wrapText="true" textAlignment="CENTER"/>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
