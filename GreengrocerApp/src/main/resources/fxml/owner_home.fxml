<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.groupxx.greengrocer.controller.OwnerHomeController"
      stylesheets="@../css/app.css"
      style="-fx-background-color: -fx-background;">

    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="top-bar">
        <Label text="Owner Dashboard" styleClass="headline-medium"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh Data" onAction="#onRefresh" styleClass="button"/>
        <Button text="Profile" onAction="#onOpenProfile" styleClass="button"/>
        <Button text="Sign Out" onAction="#onLogout" styleClass="button"/>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Incoming Orders">
                <VBox spacing="16">
                     <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                     <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                         <columns>
                             <TableColumn fx:id="oId" text="ID" prefWidth="60"/>
                             <TableColumn fx:id="oCustomer" text="Customer"/>
                             <TableColumn fx:id="oCarrier" text="Carrier"/>
                             <TableColumn fx:id="oStatus" text="Status"/>
                             <TableColumn fx:id="oTotal" text="Total"/>
                         </columns>
                     </TableView>
                </VBox>
            </Tab>

            <Tab text="Products">
                <fx:include fx:id="productsInclude" source="owner_products.fxml"/>
            </Tab>

            <Tab text="Carriers">
                <fx:include fx:id="carriersInclude" source="owner_carriers.fxml"/>
            </Tab>

            <Tab text="Messages">
                <fx:include fx:id="messagesInclude" source="owner_messages.fxml"/>
            </Tab>

            <Tab text="Discounts">
                <fx:include fx:id="discountsInclude" source="owner_discounts.fxml"/>
            </Tab>

            <Tab text="Reports">
                <fx:include fx:id="reportsInclude" source="owner_reports.fxml"/>
            </Tab>

            <Tab text="Carrier Reviews">
                <fx:include fx:id="carrierReviewsInclude" source="owner_carrier_reviews.fxml"/>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
