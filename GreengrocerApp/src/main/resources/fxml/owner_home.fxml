<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.groupxx.greengrocer.controller.OwnerHomeController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <children>
                <Label text="Owner Panel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#onRefresh"/>
                <Button text="Profile" onAction="#onOpenProfile"/>
                <Button text="Logout" onAction="#onLogout"/>
            </children>
        </HBox>
    </top>

    <center>
        <TabPane>
            <tabs>
                <Tab text="Orders" closable="false">
                    <TableView fx:id="ordersTable">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="oId" text="ID"/>
                            <TableColumn fx:id="oCustomer" text="Customer"/>
                            <TableColumn fx:id="oCarrier" text="Carrier"/>
                            <TableColumn fx:id="oStatus" text="Status"/>
                            <TableColumn fx:id="oTotal" text="Total (incl. VAT)"/>
                        </columns>
                    </TableView>
                </Tab>

                <Tab text="Products" closable="false">
                    <fx:include fx:id="productsInclude" source="owner_products.fxml"/>
                </Tab>

                <Tab text="Carriers" closable="false">
                    <fx:include fx:id="carriersInclude" source="owner_carriers.fxml"/>
                </Tab>

                <Tab text="Messages" closable="false">
                    <fx:include fx:id="messagesInclude" source="owner_messages.fxml"/>
                </Tab>

                <Tab text="Discounts" closable="false">
                    <fx:include fx:id="discountsInclude" source="owner_discounts.fxml"/>
                </Tab>

                <Tab text="Reports" closable="false">
                    <fx:include fx:id="reportsInclude" source="owner_reports.fxml"/>
                </Tab>

                <Tab text="Carrier Reviews" closable="false">
                    <fx:include fx:id="carrierReviewsInclude" source="owner_carrier_reviews.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>
