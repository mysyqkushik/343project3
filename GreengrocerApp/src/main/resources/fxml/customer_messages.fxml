<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.groupxx.greengrocer.controller.CustomerMessagesController"
      stylesheets="@../css/app.css"
      style="-fx-background-color: -fx-background;">

    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="top-bar">
        <Label text="Messages" styleClass="headline-medium"/>
        <Label text="(Direct line to Owner)" styleClass="body-medium" style="-fx-text-fill: -fx-text-secondary;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshBtn" text="Refresh" onAction="#onRefresh" styleClass="button"/>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.7" orientation="VERTICAL">
        <items>
            <!-- Message List -->
            <TableView fx:id="messageTable">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="timeCol" text="Time" prefWidth="120"/>
                    <TableColumn fx:id="fromCol" text="From" prefWidth="100"/>
                    <TableColumn fx:id="textCol" text="Message"/>
                </columns>
            </TableView>

            <!-- Input Area -->
            <VBox spacing="12">
                <padding>
                    <Insets top="16" right="24" bottom="16" left="24"/>
                </padding>
                
                <Label text="Write a message" styleClass="title-medium"/>
                <TextArea fx:id="messageInput" wrapText="true" VBox.vgrow="ALWAYS" promptText="Type your message here..."/>
                
                <HBox spacing="16" alignment="CENTER_RIGHT">
                    <Label fx:id="sendTimerLabel" styleClass="caption"/>
                    <Button fx:id="cancelSendBtn" text="Cancel" onAction="#onCancelSend" styleClass="button-danger"/>
                    <Button fx:id="sendBtn" text="Send Message" onAction="#onSend" styleClass="button-primary"/>
                </HBox>
            </VBox>
        </items>
    </SplitPane>
</VBox>
